{
  "rules": {
    "classes": {
      "$code": {
        ".read": "auth != null && data.child('host').val() === auth.uid",
        ".write": "auth != null && (!data.exists() ? (!newData.exists() || newData.child('host').val() === auth.uid) : (data.child('host').val() === auth.uid || (!newData.exists() && data.child('createdAt').val() < now - 43200000)))",
        ".validate": "$code.matches(/^[0-9]{6}$/) && newData.hasChildren(['host', 'createdAt', 'meta'])",
        "host": {
          ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)"
        },
        "meta": {
          ".read": "auth != null",
          ".validate": "newData.hasChild('since')",
          "since": {
            ".validate": "newData.isNumber()"
          },
          "focus": {
            ".validate": "newData.isString() && newData.val().length <= 64"
          },
          "focusAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "players": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('classes').child($code).child('host').exists()",
            ".validate": "newData.hasChildren(['name', 'joinedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "online": {
              ".validate": "newData.isBoolean()"
            },
            "now": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "progress": {
              "$level": {
                ".validate": "$level.length <= 64 && newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
              }
            },
            "events": {
              "$event": {
                ".validate": "$event.length <= 40 && newData.hasChildren(['type', 'levelId', 'at'])",
                "type": {
                  ".validate": "newData.val() === 'answered' || newData.val() === 'predicted' || newData.val() === 'ran'"
                },
                "levelId": {
                  ".validate": "newData.isString() && newData.val().length <= 64"
                },
                "at": {
                  ".validate": "newData.isNumber()"
                },
                "answer": {
                  ".validate": "newData.isString() && newData.val().length <= 64"
                },
                "option": {
                  ".validate": "newData.isString() && newData.val().length <= 64"
                },
                "correct": {
                  ".validate": "newData.isBoolean()"
                },
                "shipped": {
                  ".validate": "newData.isNumber()"
                },
                "met": {
                  ".validate": "newData.isBoolean()"
                },
                "stars": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
                },
                "choices": {
                  "$lever": {
                    ".validate": "$lever.length <= 64 && newData.isString() && newData.val().length <= 64"
                  }
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "opened": {
      ".read": "auth != null && query.orderByKey === true && query.endAt <= '' + (now - 43200000)",
      "$entry": {
        ".write": "auth != null && (!data.exists() ? root.child('classes').child(newData.val()).child('host').val() === auth.uid && $entry === root.child('classes').child(newData.val()).child('createdAt').val() + '_' + newData.val() : !newData.exists() && (root.child('classes').child(data.val()).child('host').val() === auth.uid || $entry < '' + (now - 43200000)))",
        ".validate": "newData.isString() && newData.val().matches(/^[0-9]{6}$/)"
      }
    }
  }
}
